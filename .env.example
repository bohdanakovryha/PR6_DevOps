# Copy to .env and adjust: cp .env.example .env
# The file is read by docker compose (variable substitution + container env)
# and by scripts/deploy.sh.

# Runtime environment name: dev | staging | prod
APP_ENV=staging
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Port inside the container and port published on the host
APP_PORT=8000
HOST_PORT=8080
# Number of gunicorn worker processes
GUNICORN_WORKERS=2

# APP_VERSION and GIT_COMMIT are baked into the image at build time.
# Uncomment only to override them for a manual experiment.
# APP_VERSION=1.0.0

# Deployment script settings
HEALTH_TIMEOUT=60
